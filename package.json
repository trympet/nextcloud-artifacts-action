{
  "name": "nextcloud-artifacts-action",
  "version": "3.0.0",
  "description": "Upload build artifacts to Nextcloud from GitHub Actions.",
  "private": true,
  "type": "module",
  "main": "lib/nextcloud-artifacts.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true }); rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint src --max-warnings=0",
    "package": "npm run clean && npm run build && ncc build lib/nextcloud-artifacts.js --source-map --license \"[name].licenses.txt\" --target es2024",
    "test": "npm run package && node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --testPathIgnorePatterns=integration.test.ts",
    "test:integration": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --ci --runTestsByPath __tests__/integration.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trympet/nextcloud-artifacts-action.git"
  },
  "keywords": [],
  "author": "Trym Lund Flogard <trym@flogard.no>",
  "license": "GPL-2.0-only",
  "bugs": {
    "url": "https://github.com/trympet/nextcloud-artifacts-action/issues"
  },
  "homepage": "https://github.com/trympet/nextcloud-artifacts-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "archiver": "^8.0.0",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.2",
    "fflate": "^0.8.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1"
  }
}
